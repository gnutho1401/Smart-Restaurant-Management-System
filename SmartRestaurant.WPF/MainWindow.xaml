<Window x:Class="SmartRestaurant.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SmartRestaurant.WPF.ViewModels"
        xmlns:views="clr-namespace:SmartRestaurant.WPF.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="Smart Restaurant Management System - .NET 8 WPF &amp; Local GenAI (PRN212 Group 6)" 
        Height="900" Width="1440" MinHeight="768" MinWidth="1280" WindowStartupLocation="CenterScreen" Background="#F4F6F9">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ViewModel to View Mapping DataTemplates -->
        <DataTemplate DataType="{x:Type vm:FloorPlanViewModel}">
            <views:FloorPlanView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PosOrderViewModel}">
            <views:PosOrderView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:KitchenKdsViewModel}">
            <views:KitchenKdsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MenuViewModel}">
            <views:MenuView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:ReportsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StaffManagementViewModel}">
            <views:StaffManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryManagementViewModel}">
            <views:InventoryManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuditLogViewModel}">
            <views:AuditLogsView/>
        </DataTemplate>

        <!-- Lock Screen PIN Numpad Key Styles -->
        <Style x:Key="NumpadKeyStyle" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#475569"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NumpadClearKeyStyle" TargetType="Button" BasedOn="{StaticResource NumpadKeyStyle}">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <!-- Modern Clean Nav Tab Button Style with Tactile Animation -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RenderTransformOrigin" Value="0.5, 0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.02" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.02" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.0" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="0.97" Duration="0:0:0.06"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="0.97" Duration="0:0:0.06"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.0" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.0" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. Master Top Brand Bar -->
            <RowDefinition Height="64"/>
            <!-- 2. Subsystem Navigation Tabs -->
            <RowDefinition Height="52"/>
            <!-- 3. Active Workspace Content Area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Master Top Brand Bar -->
        <Border Grid.Row="0" Background="#1A252F" Padding="20,0">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="🍽️" FontSize="28" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SMART RESTAURANT MANAGEMENT" FontSize="19" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Hệ Thống Quản Lý Nhà Hàng Thông Minh (.NET 8 &amp; Local GenAI / Gemini)" FontSize="11" Foreground="#BDC3C7"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <!-- AI Assistant Shortcut -->
                    <Button Content="🤖 Trợ Lý GenAI (Mistral-7B / Gemini)" Command="{Binding OpenAiAssistantCommand}"
                            Background="#8E44AD" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" Height="40" Padding="18,0" Margin="0,0,16,0" Cursor="Hand" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- User and Role Badge -->
                    <Border Background="#2C3E50" CornerRadius="8" Padding="12,6" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Role Pill Tag -->
                            <Border Background="{Binding RoleBadgeColor}" CornerRadius="4" Padding="8,3" Margin="0,0,10,0">
                                <TextBlock Text="{Binding RoleBadgeText}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Border>
                            <TextBlock Text="{Binding CurrentUserName}" FontSize="13" FontWeight="SemiBold" Foreground="#ECF0F1" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Quick Lock Screen Button -->
                    <Button Content="🔒 Khóa" Command="{Binding LockScreenCommand}"
                            Background="#475569" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" Height="36" Padding="12,0" Margin="0,0,10,0" Cursor="Hand" BorderThickness="0"
                            ToolTip="Khóa màn hình bảo vệ ca trực">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Logout Button -->
                    <Button Content="🚪 Đăng Xuất" Command="{Binding LogoutCommand}"
                            Background="#C0392B" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" Height="36" Padding="14,0" Cursor="Hand" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. Subsystem Navigation Tabs (RBAC Filtered) -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E0E6ED" BorderThickness="0,0,0,1" Padding="20,0">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <!-- Admin & Management Tabs -->
                    <Button Content="📊 Báo Cáo &amp; AI Analytics" Command="{Binding NavReportsCommand}"
                            Visibility="{Binding IsReportsAllowed, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource NavButtonStyle}"/>
                    <Button Content="👥 Quản Lý Nhân Viên" Command="{Binding NavStaffCommand}"
                            Visibility="{Binding IsStaffAllowed, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource NavButtonStyle}"/>
                    <Button Content="📦 Quản Lý Kho (BOM)" Command="{Binding NavInventoryCommand}"
                            Visibility="{Binding IsInventoryAllowed, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource NavButtonStyle}"/>
                    <Button Content="📖 Thực Đơn &amp; Dịch Vụ" Command="{Binding NavMenuCommand}"
                            Visibility="{Binding IsMenuAllowed, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource NavButtonStyle}"/>
                    <Button Content="🛡️ Nhật Ký Kiểm Toán" Command="{Binding NavAuditLogCommand}"
                            Visibility="{Binding IsAuditLogAllowed, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource NavButtonStyle}"/>

                    <!-- Operation Floor & Kitchen Tabs -->
                    <Button Content="🪑 Sơ Đồ Bàn (Floor Plan)" Command="{Binding NavFloorPlanCommand}"
                            Visibility="{Binding IsFloorPlanAllowed, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource NavButtonStyle}"/>
                    <Button Content="📱 Gọi Món POS (Touch POS)" Command="{Binding NavPosCommand}"
                            Visibility="{Binding IsPosAllowed, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource NavButtonStyle}"/>
                    <Button Content="👨‍🍳 Màn Hình Bếp (Kitchen KDS)" Command="{Binding NavKdsCommand}"
                            Visibility="{Binding IsKdsAllowed, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource NavButtonStyle}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⏱️ Ca Làm Việc (Z-Report)" Command="{Binding OpenShiftManagementCommand}"
                            Visibility="{Binding IsShiftAllowed, Converter={StaticResource BoolToVis}}"
                            Background="#0D9488" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" Height="40" Padding="14,0" Margin="0,0,10,0" Cursor="Hand" BorderThickness="0"
                            Style="{StaticResource AnimatedTouchButtonStyle}"/>
                    <Button Content="💳 Quyết Toán Hóa Đơn (VAT 8%)" Command="{Binding OpenBillingCommand}"
                            Visibility="{Binding IsBillingAllowed, Converter={StaticResource BoolToVis}}"
                            Background="#E67E22" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" Height="40" Padding="18,0" Cursor="Hand" BorderThickness="0"
                            Style="{StaticResource AnimatedTouchButtonStyle}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 3. Active Workspace Content Area -->
        <ContentControl Grid.Row="2" Content="{Binding CurrentView}"/>

        <!-- 4. Auto-Lock Screen Modal Overlay (SEC-02 Security Protection) -->
        <Border Grid.Row="0" Grid.RowSpan="3" Background="#EE0F172A"
                Visibility="{Binding IsScreenLocked, Converter={StaticResource BoolToVis}}"
                Panel.ZIndex="999">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" Color="#000000" Opacity="0.7"/>
            </Border.Effect>
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="400" Background="#1E293B" CornerRadius="18" Padding="28" BorderBrush="#334155" BorderThickness="2">
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Icon & Title -->
                        <TextBlock Text="🔒" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="MÀN HÌNH ĐÃ KHÓA" FontSize="19" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center"/>
                        <TextBlock Text="Bảo vệ ca làm việc và dữ liệu tài chính" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,3,0,16"/>

                        <!-- User Info Badge -->
                        <Border Background="#0F172A" CornerRadius="10" Padding="14,10" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Background="{Binding RoleBadgeColor}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding RoleBadgeText}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </Border>
                                <TextBlock Text="{Binding CurrentUserName}" FontWeight="Bold" FontSize="13" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- PIN / Password Display (Masked Dots) -->
                        <TextBlock Text="Nhập mật khẩu hoặc mã PIN để mở khóa:" FontSize="12" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <Border Background="#0F172A" CornerRadius="10" Height="48" BorderBrush="#475569" BorderThickness="1" Margin="0,0,0,8" Padding="16,0">
                            <TextBlock Text="{Binding LockScreenPin}" FontSize="24" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>

                        <!-- Error Message -->
                        <TextBlock Text="{Binding LockErrorMessage}" FontSize="12" Foreground="#EF4444" FontWeight="SemiBold" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,10"
                                   Visibility="{Binding LockErrorMessage, Converter={StaticResource BoolToVis}}"/>

                        <!-- Touch PIN Numpad 4x3 Grid -->
                        <UniformGrid Columns="3" Margin="0,0,0,14" Width="260">
                            <Button Content="1" Command="{Binding LockNumpadDigitCommand}" CommandParameter="1" Style="{StaticResource NumpadKeyStyle}"/>
                            <Button Content="2" Command="{Binding LockNumpadDigitCommand}" CommandParameter="2" Style="{StaticResource NumpadKeyStyle}"/>
                            <Button Content="3" Command="{Binding LockNumpadDigitCommand}" CommandParameter="3" Style="{StaticResource NumpadKeyStyle}"/>
                            <Button Content="4" Command="{Binding LockNumpadDigitCommand}" CommandParameter="4" Style="{StaticResource NumpadKeyStyle}"/>
                            <Button Content="5" Command="{Binding LockNumpadDigitCommand}" CommandParameter="5" Style="{StaticResource NumpadKeyStyle}"/>
                            <Button Content="6" Command="{Binding LockNumpadDigitCommand}" CommandParameter="6" Style="{StaticResource NumpadKeyStyle}"/>
                            <Button Content="7" Command="{Binding LockNumpadDigitCommand}" CommandParameter="7" Style="{StaticResource NumpadKeyStyle}"/>
                            <Button Content="8" Command="{Binding LockNumpadDigitCommand}" CommandParameter="8" Style="{StaticResource NumpadKeyStyle}"/>
                            <Button Content="9" Command="{Binding LockNumpadDigitCommand}" CommandParameter="9" Style="{StaticResource NumpadKeyStyle}"/>
                            <Button Content="C" Command="{Binding LockNumpadClearCommand}" Style="{StaticResource NumpadClearKeyStyle}"/>
                            <Button Content="0" Command="{Binding LockNumpadDigitCommand}" CommandParameter="0" Style="{StaticResource NumpadKeyStyle}"/>
                            <Button Content="⌫" Command="{Binding LockNumpadBackspaceCommand}" Style="{StaticResource NumpadClearKeyStyle}"/>
                        </UniformGrid>

                        <!-- Action Buttons: Unlock & Logout -->
                        <Button Content="🔓 MỞ KHÓA MÀN HÌNH" Command="{Binding UnlockScreenCommand}"
                                Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" Height="46" Width="260" Margin="0,0,0,8" Cursor="Hand" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Content="🚪 Đăng Xuất (Chuyển Ca Khác)" Command="{Binding LogoutCommand}"
                                Background="Transparent" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="12" Height="32" Cursor="Hand" BorderThickness="0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
