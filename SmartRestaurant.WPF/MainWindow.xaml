<Window x:Class="SmartRestaurant.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SmartRestaurant.WPF.ViewModels"
        xmlns:views="clr-namespace:SmartRestaurant.WPF.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="Smart Restaurant Management System - .NET 8 WPF &amp; Local GenAI (PRN212 Group 6)" 
        Height="820" Width="1280" WindowStartupLocation="CenterScreen" Background="#F4F6F9">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ViewModel to View Mapping DataTemplates -->
        <DataTemplate DataType="{x:Type vm:FloorPlanViewModel}">
            <views:FloorPlanView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PosOrderViewModel}">
            <views:PosOrderView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:KitchenKdsViewModel}">
            <views:KitchenKdsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MenuViewModel}">
            <views:MenuView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. Master Top Brand Bar -->
            <RowDefinition Height="64"/>
            <!-- 2. Subsystem Navigation Tabs -->
            <RowDefinition Height="50"/>
            <!-- 3. Active Workspace Content Area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Master Top Brand Bar -->
        <Border Grid.Row="0" Background="#1A252F" Padding="18,0">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="🍽️" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SMART RESTAURANT MANAGEMENT" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Hệ Thống Quản Lý Nhà Hàng Thông Minh (.NET 8 &amp; Local GenAI)" FontSize="11" Foreground="#BDC3C7"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <!-- AI Assistant Shortcut -->
                    <Button Content="🤖 Trợ Lý GenAI (Mistral-7B)" Command="{Binding OpenAiAssistantCommand}"
                            Background="#8E44AD" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" Height="38" Padding="16,0" Margin="0,0,16,0" Cursor="Hand" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- User and Role Badge -->
                    <Border Background="#2C3E50" CornerRadius="6" Padding="10,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Role Pill Tag -->
                            <Border Background="{Binding RoleBadgeColor}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                <TextBlock Text="{Binding RoleBadgeText}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Border>
                            <TextBlock Text="{Binding CurrentUserName}" FontSize="12" FontWeight="SemiBold" Foreground="#ECF0F1" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Logout Button -->
                    <Button Content="🚪 Đăng Xuất" Command="{Binding LogoutCommand}"
                            Background="#C0392B" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" Height="34" Padding="12,0" Cursor="Hand" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. Subsystem Navigation Tabs (RBAC Filtered) -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E0E6ED" BorderThickness="0,0,0,1" Padding="16,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="🪑 Sơ Đồ Bàn (Floor Plan)" Command="{Binding NavFloorPlanCommand}"
                        Visibility="{Binding IsFloorPlanAllowed, Converter={StaticResource BoolToVis}}"
                        Background="Transparent" Foreground="#2C3E50" FontWeight="Bold" FontSize="14" Height="48" Padding="16,0" Margin="0,0,8,0" Cursor="Hand" BorderThickness="0"/>
                <Button Content="📱 Gọi Món POS (Touch POS)" Command="{Binding NavPosCommand}"
                        Visibility="{Binding IsPosAllowed, Converter={StaticResource BoolToVis}}"
                        Background="Transparent" Foreground="#2C3E50" FontWeight="Bold" FontSize="14" Height="48" Padding="16,0" Margin="0,0,8,0" Cursor="Hand" BorderThickness="0"/>
                <Button Content="👨‍🍳 Màn Hình Bếp (Kitchen KDS)" Command="{Binding NavKdsCommand}"
                        Visibility="{Binding IsKdsAllowed, Converter={StaticResource BoolToVis}}"
                        Background="Transparent" Foreground="#2C3E50" FontWeight="Bold" FontSize="14" Height="48" Padding="16,0" Margin="0,0,8,0" Cursor="Hand" BorderThickness="0"/>
                <Button Content="📖 Thực Đơn &amp; Định Lượng BOM" Command="{Binding NavMenuCommand}"
                        Visibility="{Binding IsMenuAllowed, Converter={StaticResource BoolToVis}}"
                        Background="Transparent" Foreground="#2C3E50" FontWeight="Bold" FontSize="14" Height="48" Padding="16,0" Margin="0,0,8,0" Cursor="Hand" BorderThickness="0"/>
                <Button Content="💳 Quyết Toán Hóa Đơn (VAT 8%)" Command="{Binding OpenBillingCommand}"
                        Visibility="{Binding IsBillingAllowed, Converter={StaticResource BoolToVis}}"
                        Background="#E67E22" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" Height="36" Padding="16,0" Margin="16,0,0,0" Cursor="Hand" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <!-- 3. Active Workspace Content Area -->
        <ContentControl Grid.Row="2" Content="{Binding CurrentView}"/>
    </Grid>
</Window>
