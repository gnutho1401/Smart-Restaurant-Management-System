<UserControl x:Class="SmartRestaurant.WPF.Views.AuditLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SmartRestaurant.WPF.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:AuditLogViewModel}"
             Background="#F8FAFC">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- 1. Header Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Filter Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 3. Audit Logs Data Table -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Toolbar -->
        <Border Grid.Row="0" Margin="0,0,0,20">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🛡️" FontSize="28" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="NHẬT KÝ KIỂM TOÁN HỆ THỐNG (AUDIT TRAIL)" FontSize="20" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock Text="Lưu vết bất biến toàn bộ thao tác nhạy cảm: Hủy món, Chiết khấu, Chuyển/Gộp bàn, Quản trị ca &amp; Nhân sự" FontSize="12" Foreground="#64748B"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#E2E8F0" CornerRadius="8" Padding="12,6" Margin="0,0,12,0">
                        <TextBlock Text="{Binding TotalLogsCount, StringFormat='Tổng bản ghi: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
                    </Border>
                    <Button Content="🔄 Làm Mới Nhật Ký" Command="{Binding LoadLogsCommand}"
                            Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" Height="38" Padding="18,0" Cursor="Hand" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. Filter Bar -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="12" Padding="16" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.05" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <TextBox Grid.Column="0" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                         Height="40" VerticalContentAlignment="Center" Padding="12,0" Margin="0,0,14,0"
                         BorderBrush="#CBD5E1" BorderThickness="1" FontSize="13">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <TextBlock Grid.Column="1" Text="Lọc hành động:" VerticalAlignment="Center" Foreground="#475569" FontWeight="SemiBold" FontSize="13" Margin="0,0,10,0"/>

                <!-- Action Type Selector -->
                <ComboBox Grid.Column="2" ItemsSource="{Binding ActionFilters}" SelectedItem="{Binding SelectedActionFilter}"
                          Height="40" VerticalContentAlignment="Center" FontSize="13" BorderBrush="#CBD5E1">
                    <ComboBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </ComboBox.Resources>
                </ComboBox>

                <!-- Clear Filter -->
                <Button Grid.Column="3" Content="✕ Xóa Lọc" Command="{Binding ClearFilterCommand}"
                        Background="#F1F5F9" Foreground="#475569" FontWeight="SemiBold" Height="40" Padding="14,0" Margin="10,0,0,0" Cursor="Hand" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- 3. Audit Logs Data Table -->
        <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="12" Padding="0" BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#000000"/>
            </Border.Effect>
            <ListView ItemsSource="{Binding FilteredLogs}" BorderThickness="0" Background="Transparent"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView>
                        <!-- Timestamp -->
                        <GridViewColumn Header="Thời Gian (UTC)" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:dd/MM/yyyy HH:mm:ss}'}" FontSize="12" Foreground="#475569" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- User & Role -->
                        <GridViewColumn Header="Người Thực Hiện" Width="170">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Username}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" Margin="0,0,6,0"/>
                                        <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding UserRole}" FontSize="10" FontWeight="SemiBold" Foreground="#475569"/>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Action -->
                        <GridViewColumn Header="Hành Động" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#EFF6FF" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Action}" FontSize="12" FontWeight="Bold" Foreground="#1D4ED8"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Target Entity -->
                        <GridViewColumn Header="Đối Tượng" Width="130">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="{Binding EntityName}" FontWeight="SemiBold" Foreground="#334155"/>
                                        <Run Text="{Binding EntityId, StringFormat=' #{0}'}" Foreground="#64748B"/>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Details -->
                        <GridViewColumn Header="Chi Tiết Biến Động" Width="450">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Details}" FontSize="12" Foreground="#1E293B" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,4"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Machine Host -->
                        <GridViewColumn Header="Máy Trạm" Width="130">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding MachineName}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </Grid>
</UserControl>

