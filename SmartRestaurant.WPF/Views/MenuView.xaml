<UserControl x:Class="SmartRestaurant.WPF.Views.MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SmartRestaurant.WPF.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:MenuViewModel}"
             Background="#F4F6F9">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <!-- Left Pane: Menu Catalog List (45%) -->
            <ColumnDefinition Width="45*"/>
            <!-- Right Pane: Recipe BOM Formulation Editor (55%) -->
            <ColumnDefinition Width="55*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT PANE: CATALOG ================= -->
        <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="10" Padding="14" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="THỰC ĐƠN NHÀ HÀNG" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Content="+ Thêm Món Mới" Command="{Binding NewDishCommand}"
                            Background="#27AE60" Foreground="#FFFFFF" FontWeight="Bold" Height="36" Padding="14,0" Cursor="Hand" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </DockPanel>

                <!-- Dishes List (Full Width Stretch) -->
                <ListBox Grid.Row="1" ItemsSource="{Binding MenuItems}" SelectedItem="{Binding SelectedDish}"
                         BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#ECEFF1" BorderThickness="0,0,0,1" Padding="8,12" HorizontalAlignment="Stretch">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" Foreground="#2C3E50"/>
                                        <TextBlock Text="{Binding Category.CategoryName}" FontSize="12" Foreground="#7F8C8D"/>
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Price, Converter={StaticResource CurrencyFormatConverter}}" 
                                                   FontWeight="Bold" FontSize="15" Foreground="#E67E22" TextAlignment="Right"/>
                                        <Border Background="{Binding IsAvailable, Converter={StaticResource TableStatusToBrushConverter}}" 
                                                CornerRadius="4" Padding="8,3" HorizontalAlignment="Right" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding IsAvailable, StringFormat='Sẵn sàng: {0}'}" FontSize="10" Foreground="#FFFFFF" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ================= RIGHT PANE: BOM FORMULATION ================= -->
        <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="10" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="ĐỊNH LƯỢNG NGUYÊN LIỆU BOM (BILL-OF-MATERIALS)" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,16"/>

                    <!-- Form Controls -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Tên Món Ăn:" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding DishName, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="8,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Đơn Giá (VND):" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding DishPrice, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="8,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Danh Mục Món:" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding Categories}" SelectedValuePath="CategoryId" 
                                      SelectedValue="{Binding SelectedCategoryId}" DisplayMemberPath="CategoryName" Height="34"/>
                        </StackPanel>

                        <CheckBox Grid.Column="1" Content="Đang Bán (Sẵn Có)" IsChecked="{Binding DishIsAvailable}" 
                                  VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#2C3E50" Margin="10,18,0,0"/>
                    </Grid>

                    <!-- Culinary Description with AI Assist -->
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="Mô Tả Ẩm Thực:" FontWeight="SemiBold" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Content="✨ Sinh Mô Tả Bằng AI (LM Studio)" 
                                Command="{Binding GenerateAiDescriptionCommand}"
                                Background="#8E44AD" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Height="28" Padding="10,0" Cursor="Hand" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </DockPanel>
                    <TextBox Text="{Binding DishDescription, UpdateSourceTrigger=PropertyChanged}" 
                             Height="65" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16"/>

                    <!-- BOM Ingredients Table -->
                    <Border Background="#F9FAFC" CornerRadius="8" Padding="12" Margin="0,0,0,16" BorderBrush="#E0E6ED" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Công thức tiêu hao nguyên liệu mỗi phần ăn:" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,10"/>

                            <ItemsControl ItemsSource="{Binding RecipeIngredients}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,4">
                                            <TextBlock Text="{Binding IngredientName}" FontWeight="SemiBold" Foreground="#2C3E50" Width="180"/>
                                            <TextBox Text="{Binding QuantityRequired, UpdateSourceTrigger=PropertyChanged}" Width="70" Height="28" 
                                                     VerticalContentAlignment="Center" TextAlignment="Center" Margin="10,0"/>
                                            <TextBlock Text="{Binding Unit}" Foreground="#7F8C8D" VerticalAlignment="Center" Width="40"/>
                                            <Button Content="✕ Xóa" 
                                                    Command="{Binding DataContext.RemoveIngredientCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#E74C3C" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Height="26" Padding="8,0" Cursor="Hand" BorderThickness="0"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Add Ingredient Row -->
                            <Separator Margin="0,10" Background="#E0E6ED"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox ItemsSource="{Binding AvailableIngredients}" SelectedItem="{Binding SelectedIngredientToAdd}" 
                                          DisplayMemberPath="Name" Width="170" Height="32" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding QuantityToAdd, UpdateSourceTrigger=PropertyChanged}" Width="65" Height="32" 
                                         VerticalContentAlignment="Center" TextAlignment="Center" Margin="0,0,8,0"/>
                                <Button Content="+ Thêm Vào BOM" Command="{Binding AddIngredientCommand}"
                                        Background="#2980B9" Foreground="#FFFFFF" FontWeight="Bold" Height="32" Padding="10,0" Cursor="Hand" BorderThickness="0">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Feedback message -->
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#27AE60" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <!-- Action buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Gỡ Món" Command="{Binding DeleteDishCommand}"
                                Background="#95A5A6" Foreground="#FFFFFF" FontWeight="SemiBold" Height="42" Padding="16,0" Margin="0,0,12,0" Cursor="Hand" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="Lưu Món &amp; BOM" Command="{Binding SaveDishCommand}"
                                Background="#27AE60" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" Height="42" Padding="22,0" Cursor="Hand" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
