<UserControl x:Class="SmartRestaurant.WPF.Views.PosOrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SmartRestaurant.WPF.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:PosOrderViewModel}"
             Background="#F4F6F9">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <!-- Left Pane: Menu Catalog & Filter (62%) -->
            <ColumnDefinition Width="62*"/>
            <!-- Right Pane: Active POS Cart (38%) -->
            <ColumnDefinition Width="38*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT PANE ================= -->
        <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="10" Padding="14" Margin="0,0,10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search and Back Bar -->
                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Left" Content="⬅ Sơ Đồ Bàn" Command="{Binding BackCommand}"
                            Background="#7F8C8D" Foreground="#FFFFFF" FontWeight="SemiBold" Height="36" Padding="14,0" Cursor="Hand" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <TextBox DockPanel.Dock="Right" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" 
                             Height="36" Width="260" VerticalContentAlignment="Center" Padding="8,0" Margin="10,0,0,0"
                             BorderBrush="#BDC3C7" BorderThickness="1">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <TextBlock Text="🔍 Tìm món:" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                </DockPanel>

                <!-- Category Selector -->
                <ListBox Grid.Row="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" 
                         Margin="0,0,0,12" BorderThickness="0" Background="Transparent">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#ECF0F1" CornerRadius="16" Padding="14,8" Margin="0,0,8,0">
                                <TextBlock Text="{Binding CategoryName}" FontWeight="SemiBold" Foreground="#2C3E50"/>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Dishes Grid -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding DisplayMenuItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="195" Height="175" Margin="6" Background="#FAFAFA" CornerRadius="8" Padding="12"
                                        BorderBrush="#E0E0E0" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Dish Name -->
                                        <TextBlock Grid.Row="0" Text="{Binding Name}" FontWeight="Bold" FontSize="14" 
                                                   TextWrapping="Wrap" MaxHeight="40" Foreground="#2C3E50"/>

                                        <!-- Price -->
                                        <TextBlock Grid.Row="1" Text="{Binding Price, Converter={StaticResource CurrencyFormatConverter}}" 
                                                   FontSize="15" FontWeight="SemiBold" Foreground="#E67E22" VerticalAlignment="Center"/>

                                        <!-- Add Button (Touch target >= 48px height) -->
                                        <Button Grid.Row="2" Content="+ Chọn Món" 
                                                Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="#2980B9" Foreground="#FFFFFF" FontWeight="Bold" Height="40" Cursor="Hand" BorderThickness="0">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ================= RIGHT PANE ================= -->
        <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="10" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Active Table Title -->
                <Border Grid.Row="0" Background="#1A252F" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                    <DockPanel>
                        <TextBlock Text="{Binding CurrentTable.TableName, StringFormat='BÀN: {0}'}" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="{Binding CurrentTable.Area.AreaName}" FontSize="13" Foreground="#BDC3C7" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- Cart Items List -->
                <ListView Grid.Row="1" ItemsSource="{Binding CartItems}" BorderThickness="0" Margin="0,0,0,10">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#ECEFF1" BorderThickness="0,0,0,1" Padding="4,8" Width="360">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Name and Note -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding DishName}" FontWeight="SemiBold" FontSize="14" Foreground="#2C3E50"/>
                                        <TextBlock Text="{Binding UnitPrice, Converter={StaticResource CurrencyFormatConverter}}" FontSize="12" Foreground="#7F8C8D"/>
                                        <TextBlock Text="{Binding AllergyNote, StringFormat='⚠️ {0}'}" FontSize="11" Foreground="#C0392B" FontStyle="Italic"
                                                   Visibility="{Binding AllergyNote, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>

                                    <!-- Quantity Controls (Touch size) -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                                        <Button Content="-" Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Width="32" Height="32" FontWeight="Bold" Background="#BDC3C7" BorderThickness="0"/>
                                        <TextBlock Text="{Binding Quantity}" VerticalAlignment="Center" Margin="10,0" FontWeight="Bold" FontSize="14"/>
                                        <Button Content="+" Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Width="32" Height="32" FontWeight="Bold" Background="#BDC3C7" BorderThickness="0"/>
                                    </StackPanel>

                                    <!-- Line Total -->
                                    <TextBlock Grid.Column="2" Text="{Binding LineTotal, Converter={StaticResource CurrencyFormatConverter}}" 
                                               FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center" Width="85" TextAlignment="Right"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Allergy Note Input Area -->
                <StackPanel Grid.Row="2" Margin="0,0,0,10">
                    <TextBlock Text="Ghi chú dị ứng / lưu ý chế biến món tiếp theo:" FontSize="12" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding CurrentAllergyNote, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="8,0"
                             BorderBrush="#BDC3C7" BorderThickness="1">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </StackPanel>

                <!-- Status Feedback Message -->
                <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"
                           Foreground="{Binding IsSuccessMessage, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Order Settlement & Submission Controls -->
                <Border Grid.Row="4" Background="#FAFAFA" CornerRadius="8" Padding="12" BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel>
                        <!-- SubTotal Sum -->
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="TỔNG TẠM TÍNH:" FontSize="15" FontWeight="Bold" Foreground="#7F8C8D"/>
                            <TextBlock Text="{Binding SubTotal, Converter={StaticResource CurrencyFormatConverter}}" FontSize="20" FontWeight="Bold" Foreground="#E74C3C" HorizontalAlignment="Right"/>
                        </DockPanel>

                        <!-- Big Confirm Button (Touch target >= 48px) -->
                        <Button Content="🔔 XÁC NHẬN GỌI MÓN (TRỪ KHO BOM)" Command="{Binding ConfirmOrderCommand}"
                                Background="#27AE60" Foreground="#FFFFFF" FontWeight="Bold" FontSize="15" Height="50" Cursor="Hand" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
