<UserControl x:Class="SmartRestaurant.WPF.Views.PosOrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SmartRestaurant.WPF.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:PosOrderViewModel}"
             Background="#F4F6F9">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <!-- Left Pane: Menu Catalog & Filter (62%) -->
            <ColumnDefinition Width="62*"/>
            <!-- Right Pane: Active POS Cart (38%) -->
            <ColumnDefinition Width="38*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT PANE ================= -->
        <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="10" Padding="14" Margin="0,0,10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Row 0: Smart Upsell Recommendation Banner -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 1: Search and Back Bar -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 2: Category Selector -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 3: Dishes Grid -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 0. AI Smart Upsell Recommendation Banner -->
                <Border Grid.Row="0" Margin="0,0,0,12" Background="#FEF3C7" CornerRadius="10" Padding="14,10" BorderBrush="#F59E0B" BorderThickness="1"
                        Visibility="{Binding IsUpsellVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="✨" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding UpsellMessage}" FontWeight="Bold" FontSize="13" Foreground="#92400E" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="+ Thêm Ngay" Command="{Binding AcceptUpsellCommand}"
                                    Background="#D97706" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" Height="32" Padding="12,0" Cursor="Hand" BorderThickness="0" Margin="0,0,8,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="✕" Command="{Binding DismissUpsellCommand}"
                                    Background="Transparent" Foreground="#92400E" FontWeight="Bold" FontSize="14" Width="28" Height="28" Cursor="Hand" BorderThickness="0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Search and Back Bar -->
                <DockPanel Grid.Row="1" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Left" Content="⬅ Sơ Đồ Bàn" Command="{Binding BackCommand}"
                            Background="#7F8C8D" Foreground="#FFFFFF" FontWeight="SemiBold" Height="36" Padding="14,0" Cursor="Hand" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <TextBox DockPanel.Dock="Right" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" 
                             Height="36" Width="260" VerticalContentAlignment="Center" Padding="8,0" Margin="10,0,0,0"
                             BorderBrush="#BDC3C7" BorderThickness="1">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <TextBlock Text="Tìm món:" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                </DockPanel>

                <!-- Category Selector -->
                <ListBox Grid.Row="2" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" 
                         Margin="0,0,0,12" BorderThickness="0" Background="Transparent">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#ECF0F1" CornerRadius="16" Padding="14,8" Margin="0,0,8,0">
                                <TextBlock Text="{Binding CategoryName}" FontWeight="SemiBold" Foreground="#2C3E50"/>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Dishes Grid -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding DisplayMenuItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="215" Height="195" Margin="8" Background="#FAFAFA" CornerRadius="10" Padding="12"
                                        BorderBrush="#E0E0E0" BorderThickness="1">
                                    <Border.CacheMode>
                                        <BitmapCache EnableClearType="True" RenderAtScale="1"/>
                                    </Border.CacheMode>
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.08"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Dish Name -->
                                        <TextBlock Grid.Row="0" Text="{Binding Name}" FontWeight="Bold" FontSize="14" 
                                                   TextWrapping="Wrap" MaxHeight="38" Foreground="#2C3E50"/>

                                        <!-- Real-Time BOM Stock Portions Badge -->
                                        <Border Grid.Row="1" Background="{Binding StockBadgeColor}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,4,0,0"
                                                Visibility="{Binding HasStockBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{Binding StockBadgeText}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        </Border>

                                        <!-- Price -->
                                        <TextBlock Grid.Row="2" Text="{Binding Price, Converter={StaticResource CurrencyFormatConverter}}" 
                                                   FontSize="16" FontWeight="Bold" Foreground="#E67E22" VerticalAlignment="Center"/>

                                        <!-- Add Button (Touch target >= 46px height, disabled when out of stock) -->
                                        <Button Grid.Row="3" Content="{Binding AddButtonText}" 
                                                IsEnabled="{Binding CanOrder}"
                                                Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="{Binding AddButtonBackground}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" Height="46" Cursor="Hand" BorderThickness="0">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ================= RIGHT PANE ================= -->
        <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="10" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Active Table Title -->
                <Border Grid.Row="0" Background="#1A252F" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                    <DockPanel>
                        <TextBlock Text="{Binding CurrentTable.TableName, StringFormat='BÀN: {0}'}" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <Button DockPanel.Dock="Right" Content="Xóa Giỏ" Command="{Binding ClearCartCommand}"
                                Background="#E74C3C" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11"
                                Padding="10,5" Cursor="Hand" BorderThickness="0" Margin="8,0,0,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <TextBlock Text="{Binding CurrentTable.Area.AreaName}" FontSize="14" Foreground="#BDC3C7" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- Cart Items List (Full Width Stretch) -->
                <ListView Grid.Row="1" ItemsSource="{Binding CartItems}" BorderThickness="0" Margin="0,0,0,10"
                          HorizontalContentAlignment="Stretch">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#ECEFF1" BorderThickness="0,0,0,1" Padding="6,10" HorizontalAlignment="Stretch">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Name and Note -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding DishName}" FontWeight="SemiBold" FontSize="14" Foreground="#2C3E50"/>
                                        <TextBlock Text="{Binding UnitPrice, Converter={StaticResource CurrencyFormatConverter}}" FontSize="12" Foreground="#7F8C8D"/>
                                        <TextBlock Text="{Binding AllergyNote, StringFormat='Lưu ý: {0}'}" FontSize="11" Foreground="#C0392B" FontStyle="Italic"
                                                   Visibility="{Binding AllergyNote, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>

                                    <!-- Quantity Controls (Enlarged 38x38 Touch Target) -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                                        <Button Content="-" Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Width="38" Height="38" FontSize="16" FontWeight="Bold" Background="#BDC3C7" Foreground="#2C3E50" Cursor="Hand" BorderThickness="0">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                        <TextBlock Text="{Binding Quantity}" VerticalAlignment="Center" Margin="12,0" FontWeight="Bold" FontSize="15" MinWidth="20" TextAlignment="Center"/>
                                        <Button Content="+" Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Width="38" Height="38" FontSize="16" FontWeight="Bold" Background="#BDC3C7" Foreground="#2C3E50" Cursor="Hand" BorderThickness="0">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </StackPanel>

                                    <!-- Line Total -->
                                    <TextBlock Grid.Column="2" Text="{Binding LineTotal, Converter={StaticResource CurrencyFormatConverter}}" 
                                               FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center" Width="95" TextAlignment="Right"/>

                                    <!-- Delete Item Button (Touch Ergonomics) -->
                                    <Button Grid.Column="3" Content="✕" 
                                            Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Width="36" Height="36" Margin="8,0,0,0"
                                            Background="#FEE2E2" Foreground="#DC2626" FontSize="14" FontWeight="Bold" Cursor="Hand" BorderThickness="0"
                                            ToolTip="Xóa món khỏi giỏ">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Allergy Note Input Area -->
                <StackPanel Grid.Row="2" Margin="0,0,0,10">
                    <TextBlock Text="Ghi chú dị ứng / lưu ý chế biến món tiếp theo:" FontSize="12" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding CurrentAllergyNote, UpdateSourceTrigger=PropertyChanged}" Height="38" VerticalContentAlignment="Center" Padding="10,0"
                             BorderBrush="#BDC3C7" BorderThickness="1">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </StackPanel>

                <!-- Status Feedback Message -->
                <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"
                           Foreground="{Binding IsSuccessMessage, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Order Settlement & Submission Controls -->
                <Border Grid.Row="4" Background="#FAFAFA" CornerRadius="10" Padding="14" BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel>
                        <!-- SubTotal Sum -->
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="TỔNG TẠM TÍNH:" FontSize="15" FontWeight="Bold" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SubTotal, Converter={StaticResource CurrencyFormatConverter}}" FontSize="22" FontWeight="Bold" Foreground="#E74C3C" HorizontalAlignment="Right"/>
                        </DockPanel>

                        <!-- Big Confirm Button (Touch target 54px) -->
                        <Button Content="XÁC NHẬN GỌI MÓN (TRỪ KHO BOM)" Command="{Binding ConfirmOrderCommand}"
                                Background="#27AE60" Foreground="#FFFFFF" FontWeight="Bold" FontSize="16" Height="54" Cursor="Hand" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 5-Second Floating Undo Action Banner -->
        <Border Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
                Background="#0F172A" CornerRadius="12" Padding="20,12" BorderBrush="#334155" BorderThickness="1"
                Visibility="{Binding IsToastVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.35"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding ToastMessage}" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" Margin="0,0,20,0"/>
                <Button Content="Hoàn Tác (5s)" Command="{Binding UndoToastCommand}"
                        Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" Height="34" Padding="14,0" Cursor="Hand" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
