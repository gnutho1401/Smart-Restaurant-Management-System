<Window x:Class="SmartRestaurant.WPF.Views.AiChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SmartRestaurant.WPF.ViewModels"
        xmlns:common="clr-namespace:SmartRestaurant.WPF.Common"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:AiChatViewModel}"
        Title="Trợ Lý Ảo GenAI Nhà Hàng (Mistral-7B / Google Gemini) - SmartRestaurant" 
        Height="780" Width="900" MinHeight="700" MinWidth="850" WindowStartupLocation="CenterScreen" Background="#F4F6F9">
    <Grid>
        <!-- Main Chat Content -->
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <!-- 1. Header & AI Quick Analytics Buttons -->
                <RowDefinition Height="Auto"/>
                <!-- 2. Chat Conversation History -->
                <RowDefinition Height="*"/>
                <!-- 2.5 Quick Action Banner (PO Restock) -->
                <RowDefinition Height="Auto"/>
                <!-- 3. Query Input Bar -->
                <RowDefinition Height="Auto"/>
                <!-- 4. Status Bar -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header & Quick Action Buttons -->
            <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="10" Padding="16,14" Margin="0,0,0,14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.05" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🤖 TRỢ LÝ GENAI (MISTRAL-7B / GEMINI BACKUP)" FontSize="18" FontWeight="Bold" Foreground="#8E44AD"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="🔍 Kiểm Tra Kết Nối AI" Command="{Binding TestConnectionCommand}"
                                    Background="#E0E7FF" Foreground="#3730A3" FontWeight="SemiBold" FontSize="11" Padding="10,5" Margin="0,0,8,0"
                                    Cursor="Hand" BorderThickness="1" BorderBrush="#C7D2FE" ToolTip="Kiểm tra độ trễ và khả năng kết nối tới LM Studio (1235) hoặc Gemini">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="⚙️ Cấu Hình Gemini / Model" Command="{Binding OpenAiSettingsCommand}"
                                    Background="#F1F5F9" Foreground="#334155" FontWeight="SemiBold" FontSize="11" Padding="10,5" Margin="0,0,8,0"
                                    Cursor="Hand" BorderThickness="1" BorderBrush="#CBD5E1">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Border Background="#F3F4F6" CornerRadius="12" Padding="8,4" BorderThickness="1" BorderBrush="#E5E7EB">
                                <TextBlock Text="{Binding ConnectionBadgeText}" FontSize="11" FontWeight="Medium" Foreground="#4B5563" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="Kịch bản phân tích kinh doanh nhanh:" FontSize="12" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,0,8"/>
                    <WrapPanel Orientation="Horizontal">
                        <Button Content="📊 Ma Trận Thực Đơn BCG" Command="{Binding RunBcgCommand}" 
                                Background="#3498DB" Foreground="#FFFFFF" FontWeight="SemiBold" Height="36" Padding="14,0" Margin="0,0,8,6" Cursor="Hand" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="📈 Phân Tích Giờ Cao Điểm" Command="{Binding RunPeakHoursCommand}" 
                                Background="#E67E22" Foreground="#FFFFFF" FontWeight="SemiBold" Height="36" Padding="14,0" Margin="0,0,8,6" Cursor="Hand" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="📦 Dự Báo Nhập Kho 7 Ngày" Command="{Binding RunReorderCommand}" 
                                Background="#27AE60" Foreground="#FFFFFF" FontWeight="SemiBold" Height="36" Padding="14,0" Margin="0,0,8,6" Cursor="Hand" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="💰 Phân Tích Xu Hướng Doanh Thu" Command="{Binding RunRevenueTrendCommand}" 
                                Background="#9B59B6" Foreground="#FFFFFF" FontWeight="SemiBold" Height="36" Padding="14,0" Margin="0,0,8,6" Cursor="Hand" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- 2. Chat Conversation History -->
            <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.04" Color="#000000"/>
                </Border.Effect>
                <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,8" CornerRadius="12" Padding="16,14" MaxWidth="780"
                                        HorizontalAlignment="{Binding IsUser, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='Invert'}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter Property="Background" Value="#4F46E5"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsUser}" Value="False">
                                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                                    <Setter Property="Background" Value="#FFFFFF"/>
                                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.05" Color="#000000"/>
                                    </Border.Effect>

                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock FontWeight="Bold" FontSize="12" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="🤖 Trợ Lý SmartRestaurant"/>
                                                            <Setter Property="Foreground" Value="#1E293B"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                                    <Setter Property="Text" Value="👤 Bạn (Thu Ngân / Quản Lý)"/>
                                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Provider Pill Tag -->
                                                <Border Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="8,0,0,0"
                                                        Visibility="{Binding HasProviderBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding ProviderBadge}" FontSize="10" FontWeight="SemiBold" Foreground="#4F46E5"/>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Content="📋" ToolTip="Sao chép nội dung"
                                                        Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Content}"
                                                        Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="12" Margin="0,0,8,0"
                                                        Visibility="{Binding IsUser, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='Invert'}"/>
                                                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}" FontSize="11" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                                    <Setter Property="Foreground" Value="#E0E7FF"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Rich Formatted Markdown Content -->
                                        <TextBlock common:MarkdownHelper.MarkdownText="{Binding Content}"
                                                   TextWrapping="Wrap" FontSize="13.5" LineHeight="22">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#1E293B"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- 2.5 Quick Action Banner for 1-Click PO Restock -->
            <Border Grid.Row="2" Background="#F5F3FF" BorderBrush="#8B5CF6" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10"
                    Visibility="{Binding IsPoDraftAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📦" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Có đề xuất nhập kho nguyên vật liệu từ AI. Bấm để tự động cập nhật kho ngay:" FontWeight="SemiBold" Foreground="#6D28D9" VerticalAlignment="Center" FontSize="13"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Content="⚡ Tự Động Nhập Kho Theo Đề Xuất PO" Command="{Binding ApplyAiPoDraftCommand}"
                            Background="#7C3AED" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" Height="36" Padding="16,0" Cursor="Hand" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </DockPanel>
            </Border>

            <!-- 3. Query Input Bar -->
            <Border Grid.Row="3" Background="#FFFFFF" CornerRadius="10" Padding="8" Margin="0,0,0,8" BorderBrush="#E0E6ED" BorderThickness="1">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Gửi 💬" Command="{Binding SendQueryCommand}"
                            Background="#8E44AD" Foreground="#FFFFFF" FontWeight="Bold" FontSize="15" Width="100" Height="44" Margin="8,0,0,0" Cursor="Hand" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <TextBox Text="{Binding InputQuery, UpdateSourceTrigger=PropertyChanged}" 
                             Height="44" FontSize="14" VerticalContentAlignment="Center" Padding="12,0" BorderThickness="0">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SendQueryCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>
            </Border>

            <!-- 4. Status Bar -->
            <TextBlock Grid.Row="4" Text="{Binding StatusInfo}" FontSize="11" Foreground="#7F8C8D" Margin="4,0,0,0"/>
        </Grid>

        <!-- 5. Settings Modal Overlay -->
        <Grid Background="#7F000000" Visibility="{Binding IsSettingsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#FFFFFF" CornerRadius="12" Padding="24" Width="520" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.25" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <TextBlock Text="⚙️ CẤU HÌNH CLOUD GENAI (GOOGLE GEMINI)" FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>
                        <Button DockPanel.Dock="Right" Content="✕" Command="{Binding CloseAiSettingsCommand}"
                                Background="Transparent" BorderThickness="0" FontSize="16" FontWeight="Bold" Cursor="Hand" Foreground="#64748B"/>
                    </DockPanel>

                    <TextBlock Text="Khi máy chủ Local LM Studio không khả dụng, hệ thống sẽ tự động chuyển hướng sang Google Gemini API để phân tích kinh doanh liên tục không gián đoạn."
                               TextWrapping="Wrap" FontSize="12" Foreground="#64748B" Margin="0,0,0,16"/>

                    <TextBlock Text="Google Gemini API Key:" FontWeight="SemiBold" FontSize="13" Foreground="#334155" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding GeminiApiKeyInput, UpdateSourceTrigger=PropertyChanged}"
                             Height="38" Padding="10,0" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,14" BorderBrush="#CBD5E1"/>

                    <TextBlock Text="Mô Hình Gemini (Model):" FontWeight="SemiBold" FontSize="13" Foreground="#334155" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding AvailableGeminiModels}" SelectedItem="{Binding SelectedGeminiModel}"
                              Height="38" Margin="0,0,0,16" VerticalContentAlignment="Center"/>

                    <TextBlock Text="{Binding SettingsFeedback}" Foreground="#059669" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,12"
                               Visibility="{Binding SettingsFeedback, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Hủy Bỏ" Command="{Binding CloseAiSettingsCommand}"
                                Background="#E2E8F0" Foreground="#334155" FontWeight="SemiBold" Height="38" Padding="18,0" Margin="0,0,10,0" Cursor="Hand" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="💾 Lưu Cấu Hình" Command="{Binding SaveAiSettingsCommand}"
                                Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" Height="38" Padding="20,0" Cursor="Hand" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
