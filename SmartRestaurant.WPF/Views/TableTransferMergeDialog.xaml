<Window x:Class="SmartRestaurant.WPF.Views.TableTransferMergeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Chuyển Bàn / Gộp Bàn - Smart Restaurant" 
        Height="420" Width="520" WindowStartupLocation="CenterScreen" 
        ResizeMode="NoResize" Background="#F8FAFC">
    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <TextBlock Text="ĐIỀU PHỐI VỊ TRÍ BÀN ĂN" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                <TextBlock Text="Hỗ trợ chuyển đổi khách sang bàn mới hoặc gộp đơn với bàn khác" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 2. Action Type Selection -->
            <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="10" Padding="14" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Chọn nghiệp vụ cần thực hiện:" FontWeight="SemiBold" FontSize="13" Foreground="#334155" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RbTransfer" Content="Chuyển Bàn (Sang bàn trống)" IsChecked="True" 
                                     FontWeight="SemiBold" FontSize="13" Foreground="#0F172A" Margin="0,0,20,0" Checked="Mode_Changed"/>
                        <RadioButton x:Name="RbMerge" Content="Gộp Bàn (Gộp món vào bàn khác)" 
                                     FontWeight="SemiBold" FontSize="13" Foreground="#0F172A" Checked="Mode_Changed"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 3. Table Details Form -->
            <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="10" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <!-- Source Table -->
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="Bàn hiện tại (Nguồn):" FontWeight="SemiBold" FontSize="13" Foreground="#475569" Width="160" VerticalAlignment="Center"/>
                        <Border Background="#EFF6FF" CornerRadius="6" Padding="10,6" BorderBrush="#3B82F6" BorderThickness="1">
                            <TextBlock x:Name="TxtSourceTable" Text="T-01 (Đang dùng bữa)" FontWeight="Bold" FontSize="13" Foreground="#1D4ED8"/>
                        </Border>
                    </DockPanel>

                    <!-- Destination Table -->
                    <DockPanel>
                        <TextBlock x:Name="LblTargetTable" Text="Bàn đích muốn chuyển đến:" FontWeight="SemiBold" FontSize="13" Foreground="#475569" Width="160" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbTargetTables" Height="38" DisplayMemberPath="DisplayInfo" SelectedValuePath="TableId"
                                  FontSize="13" VerticalContentAlignment="Center" Background="#FFFFFF"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- 4. Notes / Information Alert -->
            <Border Grid.Row="3" Background="#FEF3C7" CornerRadius="8" Padding="12,10" Margin="0,14,0,0" BorderBrush="#F59E0B" BorderThickness="1" VerticalAlignment="Top">
                <TextBlock x:Name="TxtNote" Text="Lưu ý: Khi chuyển bàn, toàn bộ món ăn và hóa đơn hiện tại sẽ được chuyển tự động sang bàn đích. Bàn cũ sẽ trở về trạng thái Trống." 
                           FontSize="12" Foreground="#92400E" TextWrapping="Wrap"/>
            </Border>

            <!-- 5. Action Buttons -->
            <Grid Grid.Row="4" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1.4*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Hủy Bỏ" Height="42" Background="#E2E8F0" Foreground="#475569" 
                        FontWeight="SemiBold" FontSize="13" Cursor="Hand" BorderThickness="0" Click="Cancel_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="BtnConfirm" Grid.Column="2" Content="Xác Nhận Chuyển Bàn" Height="42" 
                        Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" Cursor="Hand" BorderThickness="0" Click="Confirm_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
