<UserControl x:Class="SmartRestaurant.WPF.Views.FloorPlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SmartRestaurant.WPF.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:FloorPlanViewModel}"
             Background="#F4F6F9">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Top Operational KPI Summary Cards -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Available Card -->
            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="8" Padding="14" Margin="0,0,8,0" BorderBrush="#27AE60" BorderThickness="0,0,0,4">
                <StackPanel>
                    <TextBlock Text="Bàn Trống (Sẵn Sàng)" FontSize="13" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding AvailableCount}" FontSize="28" FontWeight="Bold" Foreground="#27AE60" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Occupied Card -->
            <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="8" Padding="14" Margin="4,0,4,0" BorderBrush="#E74C3C" BorderThickness="0,0,0,4">
                <StackPanel>
                    <TextBlock Text="Đang Dùng Bữa" FontSize="13" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding OccupiedCount}" FontSize="28" FontWeight="Bold" Foreground="#E74C3C" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Reserved Card -->
            <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="8" Padding="14" Margin="4,0,4,0" BorderBrush="#2980B9" BorderThickness="0,0,0,4">
                <StackPanel>
                    <TextBlock Text="Đã Đặt Trước" FontSize="13" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ReservedCount}" FontSize="28" FontWeight="Bold" Foreground="#2980B9" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Cleaning Card -->
            <Border Grid.Column="3" Background="#FFFFFF" CornerRadius="8" Padding="14" Margin="8,0,0,0" BorderBrush="#F39C12" BorderThickness="0,0,0,4">
                <StackPanel>
                    <TextBlock Text="Đang Chờ Dọn Dẹp" FontSize="13" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding CleaningCount}" FontSize="28" FontWeight="Bold" Foreground="#F39C12" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. Filter & Refresh Toolbar -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="8" Padding="12" Margin="0,0,0,16">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Khu vực phòng ăn: " FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#2C3E50"/>
                    <ComboBox SelectedValue="{Binding SelectedArea, Mode=TwoWay}" Width="160" Height="34" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Tất cả" IsSelected="True"/>
                        <ComboBoxItem Content="Sảnh Chính"/>
                        <ComboBoxItem Content="VIP"/>
                        <ComboBoxItem Content="Sân Vườn"/>
                    </ComboBox>
                </StackPanel>

                <Button DockPanel.Dock="Right" Content="🔄 Làm mới Sơ đồ" Command="{Binding LoadTablesCommand}" 
                        Background="#34495E" Foreground="#FFFFFF" FontWeight="SemiBold" Height="36" Padding="16,0" Cursor="Hand" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </DockPanel>
        </Border>

        <!-- 3. Dynamic Interactive Table Grid -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Tables}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="220" Height="190" Margin="8" Background="#FFFFFF" CornerRadius="10" Padding="14"
                                BorderBrush="{Binding Status, Converter={StaticResource TableStatusToBrushConverter}}" BorderThickness="2">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#D0D3D4" Opacity="0.5"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Table Name & Status Badge -->
                                <DockPanel Grid.Row="0">
                                    <TextBlock Text="{Binding TableName}" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" DockPanel.Dock="Left"/>
                                    <Border Background="{Binding Status, Converter={StaticResource TableStatusToBrushConverter}}" 
                                            CornerRadius="12" Padding="8,2" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    </Border>
                                </DockPanel>

                                <!-- Capacity & Area Info -->
                                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding Capacity, StringFormat='Sức chứa: 👥 {0} Khách'}" FontSize="13" Foreground="#7F8C8D"/>
                                    <TextBlock Text="{Binding Area.AreaName, StringFormat='Khu vực: 📍 {0}'}" FontSize="12" Foreground="#95A5A6" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Action Buttons (Touch size >= 48px combined) -->
                                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                    <!-- Open POS / Take Order -->
                                    <Button Content="Gọi Món POS" 
                                            Command="{Binding DataContext.OpenTableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="#27AE60" Foreground="#FFFFFF" FontWeight="SemiBold" Height="34" Padding="8,0" Margin="0,0,4,0" Cursor="Hand" BorderThickness="0">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <!-- Settle / Bill Table -->
                                    <Button Content="Thanh Toán" 
                                            Command="{Binding DataContext.PayTableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="#E67E22" Foreground="#FFFFFF" FontWeight="SemiBold" Height="34" Padding="8,0" Margin="0,0,4,0" Cursor="Hand" BorderThickness="0">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <!-- Clean Done button (visible if Cleaning) -->
                                    <Button Content="Dọn Xong" 
                                            Command="{Binding DataContext.CleanTableDoneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="#F39C12" Foreground="#FFFFFF" FontWeight="SemiBold" Height="34" Padding="8,0" Cursor="Hand" BorderThickness="0">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
