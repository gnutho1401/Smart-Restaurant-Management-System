<UserControl x:Class="SmartRestaurant.WPF.Views.KitchenKdsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SmartRestaurant.WPF.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:KitchenKdsViewModel}"
             Background="#1E272E">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Header bar: Station Status -->
            <RowDefinition Height="Auto"/>
            <!-- Active Ticket Queue -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Bar: Station status summary -->
        <Border Grid.Row="0" Background="#2C3A47" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="👨‍🍳 TRẠM BẾP TRƯỞNG KDS" FontSize="20" FontWeight="Bold" Foreground="#F5F6FA" VerticalAlignment="Center" Margin="0,0,24,0"/>
                    
                    <!-- Counters -->
                    <Border Background="#E67E22" CornerRadius="12" Padding="10,4" Margin="0,0,10,0">
                        <TextBlock Text="{Binding PendingCount, StringFormat='Chờ Nấu: {0}'}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="13"/>
                    </Border>
                    <Border Background="#F1C40F" CornerRadius="12" Padding="10,4" Margin="0,0,10,0">
                        <TextBlock Text="{Binding CookingCount, StringFormat='Đang Nấu: {0}'}" FontWeight="Bold" Foreground="#1E272E" FontSize="13"/>
                    </Border>
                    <Border Background="#2ECC71" CornerRadius="12" Padding="10,4">
                        <TextBlock Text="{Binding ReadyCount, StringFormat='Sẵn Sàng Ra Món: {0}'}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="13"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="⏱️ Tự động làm mới mỗi 3s" Foreground="#BDC3C7" VerticalAlignment="Center" Margin="0,0,14,0" FontStyle="Italic"/>
                    <Button Content="🔄 Làm Mới" Command="{Binding LoadTicketsCommand}" 
                            Background="#34495E" Foreground="#FFFFFF" FontWeight="SemiBold" Height="36" Padding="14,0" Cursor="Hand" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. Live Order Ticket Queue Grid -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Tickets}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Urgency Border: Green <10m, Yellow 10-20m, Red >20m -->
                        <Border Width="280" MinHeight="250" Margin="8" Background="#2C3A47" CornerRadius="10" Padding="14"
                                BorderBrush="{Binding UrgencyBrush}" BorderThickness="3">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Table, Order ID and Timer -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding TableName}" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" DockPanel.Dock="Left"/>
                                    <TextBlock Text="{Binding ElapsedDisplay}" FontSize="13" FontWeight="Bold" Foreground="{Binding UrgencyBrush}" 
                                               DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>

                                <TextBlock Grid.Row="1" Text="{Binding OrderId, StringFormat='Đơn hàng #{0:D4}'}" FontSize="12" Foreground="#BDC3C7" Margin="0,0,0,8"/>

                                <!-- Dish and Allergy Warnings -->
                                <StackPanel Grid.Row="2" Margin="0,0,0,14">
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding DishName}" FontSize="18" FontWeight="Bold" Foreground="#F5F6FA" TextWrapping="Wrap" Width="200"/>
                                        <Border Background="#E67E22" CornerRadius="6" Padding="10,3" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Quantity, StringFormat='x{0}'}" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        </Border>
                                    </DockPanel>

                                    <!-- Allergy Note Callout Badge -->
                                    <Border Background="#C0392B" CornerRadius="6" Padding="10,6" Margin="0,4,0,0"
                                            Visibility="{Binding AllergyNote, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding AllergyNote, StringFormat='⚠️ LƯU Ý DỊ ỨNG: {0}'}" 
                                                   Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>

                                <!-- Big Touch Action Button (52px) -->
                                <Button Grid.Row="3" Content="{Binding ActionButtonText}" 
                                        Command="{Binding DataContext.AdvanceStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Background="{Binding UrgencyBrush}" Foreground="#1E272E" FontWeight="Bold" FontSize="16" Height="52" Cursor="Hand" BorderThickness="0">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
