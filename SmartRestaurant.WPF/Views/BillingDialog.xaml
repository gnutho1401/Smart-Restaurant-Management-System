<Window x:Class="SmartRestaurant.WPF.Views.BillingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SmartRestaurant.WPF.ViewModels"
        xmlns:coreEnums="clr-namespace:SmartRestaurant.Core.Enums;assembly=SmartRestaurant.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:BillingViewModel}"
        Title="Quyết Toán Hóa Đơn &amp; Quản Lý Thành Viên - SmartRestaurant" 
        Height="780" Width="1020" MinHeight="720" MinWidth="960" WindowStartupLocation="CenterScreen" Background="#ECEFF1">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <!-- Left: Paper Receipt Print Preview (50%) -->
            <ColumnDefinition Width="50*"/>
            <!-- Right: Tender Payment Controls (50%) -->
            <ColumnDefinition Width="50*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT: RECEIPT PREVIEW ================= -->
        <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="8" Padding="20" Margin="0,0,12,0" x:Name="ReceiptPrintArea">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#B0BEC5" Opacity="0.4"/>
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Receipt Header -->
                    <TextBlock Text="SMART RESTAURANT" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#1A252F"/>
                    <TextBlock Text="Đại học FPT - Hệ Thống PRN212 Nhóm 6" FontSize="11" HorizontalAlignment="Center" Foreground="#7F8C8D" Margin="0,2,0,8"/>
                    
                    <!-- Dynamic Bill Title: Phieu Tam Tinh / Hoa Don VAT -->
                    <Border Background="#FEF3C7" CornerRadius="6" Padding="10,6" Margin="0,0,0,12" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding BillTitle}" FontSize="14" FontWeight="Bold" Foreground="#B45309" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Meta info -->
                    <DockPanel Margin="0,2">
                        <TextBlock Text="{Binding TableName, StringFormat='Vị trí: {0}'}" FontWeight="Bold" FontSize="13" Foreground="#2C3E50"/>
                        <TextBlock Text="{Binding OrderId, StringFormat='Số Đơn: #{0:D4}'}" HorizontalAlignment="Right" Foreground="#7F8C8D"/>
                    </DockPanel>
                    <DockPanel Margin="0,2,0,8">
                        <TextBlock Text="{Binding InvoiceCode, StringFormat='Số HĐ: {0}'}" FontSize="12" Foreground="#7F8C8D"/>
                        <TextBlock Text="{Binding CurrentFormattedDate}" 
                                   HorizontalAlignment="Right" FontSize="12" Foreground="#7F8C8D"/>
                    </DockPanel>

                    <!-- Attached Member Banner on Receipt -->
                    <Border Background="#F1F5F9" CornerRadius="6" Padding="10,6" Margin="0,2,0,8" 
                            Visibility="{Binding HasFoundCustomer, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="👑 Hội viên:" FontWeight="SemiBold" FontSize="12" Foreground="#334155"/>
                                <TextBlock Text="{Binding FoundCustomer.FullName}" FontWeight="Bold" FontSize="12" Foreground="#1E293B" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <DockPanel Margin="0,2,0,0">
                                <TextBlock Text="{Binding FoundCustomer.Tier, StringFormat='Hạng: {0}'}" FontSize="11" Foreground="#2563EB" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding FoundCustomer.LoyaltyPoints, StringFormat='Điểm hiện tại: {0:N0} pts'}" FontSize="11" Foreground="#16A34A" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Separator Background="#2C3E50" Margin="0,4"/>

                    <!-- Line items -->
                    <ItemsControl ItemsSource="{Binding OrderItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding MenuItem.Name}" FontSize="13" Foreground="#2C3E50"/>
                                        <TextBlock Text="[ĐÃ HỦY MÓN]" FontSize="11" Foreground="#DC2626" FontWeight="Bold" 
                                                   Visibility="{Binding IsCancelled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat='x{0}'}" FontSize="13" Margin="10,0" Foreground="#7F8C8D"/>
                                    <TextBlock Grid.Column="2" Text="{Binding UnitPrice, Converter={StaticResource CurrencyFormatConverter}}" 
                                               FontSize="13" FontWeight="SemiBold" Foreground="#2C3E50" TextAlignment="Right" Width="80"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Separator Background="#BDC3C7" Margin="0,10"/>

                    <!-- Financial Summary Breakdown -->
                    <DockPanel Margin="0,3">
                        <TextBlock Text="Tạm tính (SubTotal):" Foreground="#7F8C8D" FontSize="13"/>
                        <TextBlock Text="{Binding SubTotal, Converter={StaticResource CurrencyFormatConverter}}" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold"/>
                    </DockPanel>
                    <DockPanel Margin="0,3">
                        <TextBlock Text="Chiết khấu (Hội viên/Voucher):" Foreground="#7F8C8D" FontSize="13"/>
                        <TextBlock Text="{Binding DiscountAmount, Converter={StaticResource CurrencyFormatConverter}}" HorizontalAlignment="Right" FontSize="13" Foreground="#C0392B"/>
                    </DockPanel>
                    <DockPanel Margin="0,3">
                        <TextBlock Text="Tiền chịu thuế:" Foreground="#7F8C8D" FontSize="13"/>
                        <TextBlock Text="{Binding TaxableAmount, Converter={StaticResource CurrencyFormatConverter}}" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold"/>
                    </DockPanel>
                    <DockPanel Margin="0,3">
                        <TextBlock Text="Thuế GTGT (VAT 8% luật định):" Foreground="#7F8C8D" FontSize="13"/>
                        <TextBlock Text="{Binding VatAmount, Converter={StaticResource CurrencyFormatConverter}}" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="#2980B9"/>
                    </DockPanel>

                    <Separator Background="#2C3E50" Margin="0,8"/>

                    <DockPanel Margin="0,4">
                        <TextBlock Text="TỔNG TIỀN PHẢI TRẢ:" FontSize="16" FontWeight="Bold" Foreground="#1A252F"/>
                        <TextBlock Text="{Binding TotalDue, Converter={StaticResource CurrencyFormatConverter}}" FontSize="20" FontWeight="Bold" Foreground="#E74C3C" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <Separator Background="#BDC3C7" Margin="0,12"/>

                    <!-- Footer message -->
                    <TextBlock Text="Cảm ơn Quý khách &amp; Hẹn gặp lại!" FontStyle="Italic" HorizontalAlignment="Center" Foreground="#7F8C8D" FontSize="12"/>
                    <TextBlock Text="VAT Included in accordance with Law" HorizontalAlignment="Center" Foreground="#BDC3C7" FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ================= RIGHT: PAYMENT & MEMBERSHIP CONTROLS ================= -->
        <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="8" Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 1. VIP Loyalty Membership Section -->
                    <Border Background="#F8FAFC" CornerRadius="8" Padding="14" Margin="0,0,0,14" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="👑 HỘI VIÊN &amp; TÍCH ĐIỂM VIP" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8"/>
                            
                            <!-- Search by Phone -->
                            <TextBlock Text="Nhập số điện thoại khách hàng:" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding PhoneNumberSearch, UpdateSourceTrigger=PropertyChanged}" 
                                         Height="34" VerticalContentAlignment="Center" Padding="8,0" FontSize="13"/>
                                <Button Grid.Column="2" Content="🔍 Tìm Hội Viên" Command="{Binding SearchCustomerCommand}"
                                        Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" Padding="12,0" Height="34" Cursor="Hand" BorderThickness="0">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>

                            <!-- Member Found Card -->
                            <StackPanel Visibility="{Binding HasFoundCustomer, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border Background="#ECFDF5" CornerRadius="6" Padding="10" Margin="0,4,0,8" BorderBrush="#10B981" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding CustomerSummaryText}" FontWeight="Bold" FontSize="12" Foreground="#065F46"/>
                                        <TextBlock Text="Đã tự động áp dụng ưu đãi chiết khấu theo hạng hội viên." FontSize="11" Foreground="#047857" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Redeem Points Row -->
                                <TextBlock Text="Đổi điểm tích lũy (1 điểm = 1.000 đ):" FontSize="12" Foreground="#64748B" Margin="0,2,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding PointsToRedeem, UpdateSourceTrigger=PropertyChanged}" 
                                             Height="34" VerticalContentAlignment="Center" Padding="8,0" FontSize="13"/>
                                    <Button Grid.Column="2" Content="🎁 Áp Dụng Điểm" Command="{Binding ApplyPointsCommand}"
                                            Background="#10B981" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" Padding="12,0" Height="34" Cursor="Hand" BorderThickness="0">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Quick Register if Not Found -->
                            <StackPanel Visibility="{Binding HasFoundCustomer, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                <Border Background="#FFFBEB" CornerRadius="6" Padding="10" Margin="0,4,0,0" BorderBrush="#FCD34D" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Chưa là hội viên? Đăng ký nhanh tại chỗ:" FontSize="12" FontWeight="SemiBold" Foreground="#92400E" Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding NewCustomerName, UpdateSourceTrigger=PropertyChanged}" 
                                                     Height="32" VerticalContentAlignment="Center" Padding="8,0" FontSize="12"/>
                                            <Button Grid.Column="2" Content="➕ Đăng Ký Mới" Command="{Binding RegisterCustomerCommand}"
                                                    Background="#F59E0B" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="10,0" Height="32" Cursor="Hand" BorderThickness="0">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="6"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 2. Payment Method Selector -->
                    <TextBlock Text="💳 PHƯƠNG THỨC THANH TOÁN" FontSize="14" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <RadioButton Content="Tiền Mặt (Cash)" GroupName="PayMethod" 
                                     IsChecked="{Binding SelectedMethod, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Cash, Mode=TwoWay}"
                                     FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,14,0" VerticalAlignment="Center"/>
                        <RadioButton Content="Thẻ (Card)" GroupName="PayMethod" 
                                     IsChecked="{Binding SelectedMethod, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=CreditCard, Mode=TwoWay}"
                                     FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,14,0" VerticalAlignment="Center"/>
                        <RadioButton Content="VietQR (Chuyển khoản)" GroupName="PayMethod" 
                                     IsChecked="{Binding SelectedMethod, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=BankTransferQR, Mode=TwoWay}"
                                     FontWeight="SemiBold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Manual Discount / Voucher -->
                    <TextBlock Text="Chiết khấu phụ / Voucher (VND):" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,10"/>

                    <!-- Amount Paid Input -->
                    <TextBlock Text="Tiền khách đưa (VND):" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding AmountPaid, UpdateSourceTrigger=PropertyChanged}" Height="40" FontSize="16" FontWeight="Bold" 
                             VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,0,10" Foreground="#27AE60" BorderBrush="#BDC3C7" BorderThickness="1">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <!-- Change Due -->
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="Tiền thừa trả khách:" FontSize="14" FontWeight="SemiBold" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ChangeDue, Converter={StaticResource CurrencyFormatConverter}}" FontSize="20" FontWeight="Bold" Foreground="#27AE60" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <!-- Feedback -->
                    <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" Foreground="#27AE60" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <!-- Action Buttons: Pre-Check & Settle -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Pre-check Print -->
                        <Button Grid.Column="0" Content="📄 In Tạm Tính" Click="PrintPreCheck_Click"
                                Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" Height="48" Cursor="Hand" BorderThickness="0"
                                ToolTip="In bản xem trước tạm tính chưa thanh toán để khách đối chiếu">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- Settle Button -->
                        <Button Grid.Column="2" Content="✅ HOÀN TẤT THANH TOÁN" Command="{Binding SettlePaymentCommand}"
                                Background="#16A34A" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" Height="48" Cursor="Hand" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <!-- Official Receipt Print Button -->
                    <Button Content="🖨️ IN HÓA ĐƠN CHÍNH THỨC (VAT 8%)" Click="PrintReceipt_Click"
                            Background="#334155" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" Height="40" Cursor="Hand" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>