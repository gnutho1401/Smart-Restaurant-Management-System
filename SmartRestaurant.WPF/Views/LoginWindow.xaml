<Window x:Class="SmartRestaurant.WPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SmartRestaurant.WPF.ViewModels"
        xmlns:common="clr-namespace:SmartRestaurant.WPF.Common"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:LoginViewModel}"
        Title="Đăng Nhập - Smart Restaurant Management System (.NET 8 &amp; Local GenAI)"
        Height="560" Width="880"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <!-- Converters or Styles -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <!-- Main Outer Container with Drop Shadow & Corner Radius -->
    <Border CornerRadius="16" Background="#FFFFFF" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Left Banner (Brand & Role Notice) -->
                <ColumnDefinition Width="360"/>
                <!-- Right Form (Login Credentials) -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 1. LEFT BRAND BANNER -->
            <Border Grid.Column="0" CornerRadius="16,0,0,16" Background="#1A252F" Padding="32">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Logo -->
                    <StackPanel Grid.Row="0">
                        <Border Background="#2C3E50" Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Left" Margin="0,0,0,16">
                            <TextBlock Text="SR" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="SMART RESTAURANT" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Hệ Thống Quản Lý Thông Minh" FontSize="13" Foreground="#BDC3C7" Margin="0,4,0,0"/>
                        <Border Background="#E67E22" Height="3" Width="48" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                    </StackPanel>

                    <!-- Middle Feature List -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="KIẾN TRÚC BẢO MẬT &amp; VẬN HÀNH" FontSize="11" FontWeight="Bold" Foreground="#95A5A6" Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="•" FontSize="14" FontWeight="Bold" Foreground="#E67E22" Margin="0,0,10,0"/>
                            <TextBlock Text="Mã hóa PBKDF2-SHA256 (100k rounds)" FontSize="12" Foreground="#ECF0F1"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="•" FontSize="14" FontWeight="Bold" Foreground="#E67E22" Margin="0,0,10,0"/>
                            <TextBlock Text="Phân quyền vai trò RBAC chặt chẽ" FontSize="12" Foreground="#ECF0F1"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="•" FontSize="14" FontWeight="Bold" Foreground="#E67E22" Margin="0,0,10,0"/>
                            <TextBlock Text="Trí tuệ nhân tạo Local GenAI Mistral-7B" FontSize="12" Foreground="#ECF0F1"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="•" FontSize="14" FontWeight="Bold" Foreground="#E67E22" Margin="0,0,10,0"/>
                            <TextBlock Text="Khấu trừ định lượng BOM nguyên tử" FontSize="12" Foreground="#ECF0F1"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Bottom Info -->
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="PRN212 - Đồ Án Nhóm 6" FontSize="11" Foreground="#7F8C8D"/>
                        <TextBlock Text="Phiên bản 2.0 LTS (.NET 8.0 WPF)" FontSize="11" Foreground="#7F8C8D"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. RIGHT LOGIN FORM -->
            <Grid Grid.Column="1" Margin="36,28,36,28">
                <!-- Close Button in Top Right -->
                <Button Content="✕" Click="CloseButton_Click" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="Transparent" Foreground="#7F8C8D" FontSize="16" FontWeight="Bold"
                        BorderThickness="0" Cursor="Hand" Width="30" Height="30"/>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Đăng Nhập Nhân Viên" FontSize="24" FontWeight="Bold" Foreground="#2C3E50"/>
                    <TextBlock Text="Vui lòng đăng nhập bằng tài khoản được cấp quyền" FontSize="13" Foreground="#7F8C8D" Margin="0,4,0,20"/>

                    <!-- Error Alert -->
                    <Border Background="#FDEDEC" BorderBrush="#E74C3C" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,14"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#C0392B" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Username Field -->
                    <TextBlock Text="Tên Đăng Nhập" FontSize="12" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,6"/>
                    <Border Background="#F8F9FA" BorderBrush="#DCE4EC" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,0,14">
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="14" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" Padding="4,4"/>
                    </Border>

                    <!-- Password Field -->
                    <TextBlock Text="Mật Khẩu" FontSize="12" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,6"/>
                    <Border Background="#F8F9FA" BorderBrush="#DCE4EC" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,0,20">
                        <PasswordBox common:PasswordBoxHelper.BindPassword="True"
                                     common:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay}"
                                     FontSize="14" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" Padding="4,4"/>
                    </Border>

                    <!-- Login Button -->
                    <Button Content="ĐĂNG NHẬP" Command="{Binding LoginCommand}" Height="44" Background="#E67E22" Foreground="#FFFFFF"
                            FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand" Margin="0,0,0,18">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Separator Margin="0,4,0,14" Background="#ECF0F1"/>

                    <!-- Demo Fast Role Switcher -->
                    <TextBlock Text="Chọn nhanh tài khoản thử nghiệm phân quyền (RBAC):" FontSize="11" FontWeight="Bold" Foreground="#7F8C8D" Margin="0,0,0,8"/>
                    <UniformGrid Columns="4" Rows="1">
                        <!-- Admin -->
                        <Button Command="{Binding QuickSelectUserCommand}" CommandParameter="Admin"
                                Background="#EBF5FB" BorderBrush="#3498DB" BorderThickness="1" Height="34" Margin="2" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                            </Button.Resources>
                            <TextBlock Text="Admin" FontSize="11" FontWeight="Bold" Foreground="#2980B9"/>
                        </Button>

                        <!-- Manager -->
                        <Button Command="{Binding QuickSelectUserCommand}" CommandParameter="Manager"
                                Background="#F4ECF7" BorderBrush="#8E44AD" BorderThickness="1" Height="34" Margin="2" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                            </Button.Resources>
                            <TextBlock Text="Quản Lý" FontSize="11" FontWeight="Bold" Foreground="#8E44AD"/>
                        </Button>

                        <!-- Cashier -->
                        <Button Command="{Binding QuickSelectUserCommand}" CommandParameter="Cashier"
                                Background="#FEF9E7" BorderBrush="#F39C12" BorderThickness="1" Height="34" Margin="2" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                            </Button.Resources>
                            <TextBlock Text="Thu Ngân" FontSize="11" FontWeight="Bold" Foreground="#D68910"/>
                        </Button>

                        <!-- Chef -->
                        <Button Command="{Binding QuickSelectUserCommand}" CommandParameter="Chef"
                                Background="#E8F8F5" BorderBrush="#1ABC9C" BorderThickness="1" Height="34" Margin="2" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                            </Button.Resources>
                            <TextBlock Text="Đầu Bếp" FontSize="11" FontWeight="Bold" Foreground="#16A085"/>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
